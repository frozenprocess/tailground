{
  "policy": "{\n  // tag:web is defined, but tag:db is missing from tagOwners, so the devices\n  // carrying it can't be targeted yet. Add tag:db to tagOwners, then add a rule\n  // that lets tag:web reach tag:db on 5432.\n  \"tagOwners\": {\n    \"tag:web\": [\"alice@example.com\"],\n  },\n  \"grants\": [\n    { \"src\": [\"alice@example.com\", \"bob@example.com\"], \"dst\": [\"tag:web\"], \"ip\": [\"tcp:443\"] },\n  ],\n  \"tests\": [\n    { \"src\": \"alice@example.com\", \"accept\": [\"tag:web:443\"], \"deny\": [\"tag:db:5432\"] },\n    { \"src\": \"tag:web\", \"accept\": [\"tag:db:5432\"], \"deny\": [\"tag:db:22\"] },\n  ],\n}\n",
