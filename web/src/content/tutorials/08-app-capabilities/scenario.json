{
  "policy": "{\n  // A grant can also carry an application capability: a named blob of JSON your\n  // own service reads to make its own authorization decisions. There are no\n  // automated checks here — add the \"app\" block, then click the\n  // alice-laptop → web-1 cell and look at \"App capabilities granted\".\n  \"groups\": {\n    \"group:eng\": [\"alice@example.com\", \"bob@example.com\"],\n  },\n  \"tagOwners\": {\n    \"tag:web\": [\"group:eng\"],\n    \"tag:db\": [\"group:eng\"],\n  },\n  \"grants\": [\n    {\n      \"src\": [\"group:eng\"],\n      \"dst\": [\"tag:web\"],\n      \"ip\": [\"tcp:443\"],\n      // TODO: add\n      //   \"app\": { \"example.com/cap/deploy\": [{ \"env\": \"staging\" }] }\n    },\n  ],\n}\n",
