{
  "policy": "{\n  \"tagOwners\": { \"tag:srv\": [\"alice@corp.example\"] },\n  \"ssh\": [\n    { \"action\": \"accept\", \"src\": [\"autogroup:member\"], \"dst\": [\"tag:srv\"], \"users\": [\"localpart:*@corp.example\"] }\n  ]\n}",
  "snapshot": {
    "users": [
      { "id": 1, "email": "alice@corp.example" },
      { "id": 2, "email": "bob@other.example" }
    ],
    "devices": [
      { "id": 1, "name": "alice-laptop", "user": "alice@corp.example", "ipv4": "100.64.0.1" },
      { "id": 2, "name": "bob-laptop", "user": "bob@other.example", "ipv4": "100.64.0.2" },
      { "id": 3, "name": "srv", "tags": ["tag:srv"], "ipv4": "100.64.0.3" }
    ]
  },
  "probes": [
    { "name": "ssh", "proto": "tcp", "port": 22 }
  ],
  "sshUsers": ["alice", "bob", "root"]
}
